# =============================================================================
# MobileAutomation 项目级 .gitignore
# =============================================================================

# ── Python 编译缓存 ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── 构建产物 ────────────────────────────────────────────────────
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── 虚拟环境 ────────────────────────────────────────────────────
venv/
env/
ENV/
.venv/

# ── 敏感信息 ────────────────────────────────────────────────────
.env
.env.local
.env.production
.env.staging
*.pem
*.key
*.p12
*.keystore
*.jks
credentials.json
service-account*.json

# ── IDE / 编辑器 ────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── macOS 系统文件 ──────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Appium 缓存 ─────────────────────────────────────────────────
.appium_home/
.appium/

# ── Node.js ─────────────────────────────────────────────────────
node_modules/
.npm/
package-lock.json

# ── 日志 ────────────────────────────────────────────────────────
*.log
logs/

# ── 测试产物 ────────────────────────────────────────────────────
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/

# ── 运行时生成目录 ─────────────────────────────────────────────
screenshots/
reports/
data/
docker-volumes/

# ── LangGraph 检查点 ────────────────────────────────────────────
.langgraph/
