# Appium Dockerfile
#
# 基于 node:20-slim 构建 Appium 服务镜像，用于移动端设备自动化控制。
# 参考用途：在容器化环境中运行 Appium 服务以连接移动设备或模拟器。

# 使用 Node.js 20 精简版作为基础镜像
FROM node:20-slim

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV APPIUM_HOME=/app/appium

# 安装系统依赖（Appium 需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libusb-1.0-0 \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# 全局安装 Appium
RUN npm install -g appium

# 安装 Appium Android Driver
RUN appium driver install uiautomator2

# 暴露 Appium 默认端口
EXPOSE 4723

# 启动 Appium 服务
CMD ["appium", "--address", "0.0.0.0", "--port", "4723", "--allow-cors", "--base-path", "/"]
