# LangGraph Agent Dockerfile
#
# 基于 python:3.11-slim 构建 LangGraph Agent 服务镜像，用于编排和执行自动化测试流程。

# 使用 Python 3.11 精简版作为基础镜像
FROM python:3.11-slim

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件并安装 Python 依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制项目源码
COPY src/ ./src/
COPY pyproject.toml .

# 暴露 LangGraph Agent 服务端口
EXPOSE 8001

# 启动 LangGraph Agent Service
CMD ["python", "-m", "src.langgraph_agent"]